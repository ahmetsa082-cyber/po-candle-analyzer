
const { analyzeCandle, analyzePatterns } =
    require("./po_candle_reader");

const tests = [
    {
        name: "Bullish Engulfing",
        candles: [
            { open: 10, high: 10.5, low: 7.5, close: 8 },
            { open: 7.5, high: 11, low: 7, close: 10.5 }
        ]
    },
    {
        name: "Bearish Engulfing",
        candles: [
            { open: 8, high: 10.5, low: 7.5, close: 10 },
            { open: 10.5, high: 11, low: 7, close: 7.5 }
        ]
    },
    {
        name: "Morning Star",
        candles: [
            { open: 10, high: 10.5, low: 5.5, close: 6 },
            { open: 5.8, high: 6.3, low: 5.5, close: 6.2 },
            { open: 6.1, high: 9.8, low: 6, close: 9.5 }
        ]
    },
    {
        name: "Evening Star",
        candles: [
            { open: 6, high: 10.5, low: 5.5, close: 10 },
            { open: 10.1, high: 10.4, low: 9.9, close: 10.3 },
            { open: 10, high: 10.2, low: 6, close: 6.5 }
        ]
    },
    {
        name: "Three White Soldiers",
        candles: [
            { open: 1, high: 2.2, low: 0.9, close: 2 },
            { open: 2, high: 3.2, low: 1.9, close: 3 },
            { open: 3, high: 4.2, low: 2.9, close: 4 }
        ]
    },
    {
        name: "Three Black Crows",
        candles: [
            { open: 4, high: 4.1, low: 2.8, close: 3 },
            { open: 3, high: 3.1, low: 1.8, close: 2 },
            { open: 2, high: 2.1, low: 0.8, close: 1 }
        ]
    }
];

for (const test of tests) {
    const result = analyzePatterns(test.candles);
    const passed = result.includes(test.name);

    console.log(`${test.name}: ${passed ? "PASS" : "FAIL"}`);
}

