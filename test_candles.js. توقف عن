
const { analyzeCandle } = require("./po_candle_reader");

const tests = [
    {
        name: "Hammer",
        candle: { open: 100, high: 101, low: 90, close: 101 },
        expected: "Hammer"
    },
    {
        name: "Shooting Star",
        candle: { open: 100, high: 110, low: 99, close: 100 },
        expected: "Shooting Star"
    },
    {
        name: "Doji",
        candle: { open: 100, high: 105, low: 95, close: 100 },
        expected: "Doji"
    }
];

for (const test of tests) {
    const result = analyzeCandle(test.candle);
    const passed = result.includes(test.expected);

    console.log(
        `${test.name}: ${passed ? "PASS" : "FAIL"}`
    );
}
